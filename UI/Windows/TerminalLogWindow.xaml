<Window x:Class="UI.Windows.TerminalLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Width="580"
        Height="360"
        Title="Terminal Logs">

    <Window.Background>
        <SolidColorBrush Color="#00000000"/>
    </Window.Background>

    <Window.Resources>
        <!-- Modern Neon Tab Button Style -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Action Button Style -->
        <Style x:Key="MiniActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#35FFFFFF"/>
                                <Setter Property="Foreground" Value="#00E676"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monospace Terminal Log TextBox -->
        <Style x:Key="TerminalBox" TargetType="TextBox">
            <Setter Property="Background" Value="#080D18"/>
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#00E676"/>
        </Style>
    </Window.Resources>

    <!-- Outer Glass Frame -->
    <Border CornerRadius="14"
            BorderBrush="#2AFFFFFF"
            BorderThickness="1"
            Margin="6"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F2101828" Offset="0"/>
                <GradientStop Color="#F2080F1C" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.75" Direction="315"/>
        </Border.Effect>

        <Grid Margin="12,10,12,10">
            <Grid.RowDefinitions>
                <!-- Title & Drag Header -->
                <RowDefinition Height="Auto"/>
                <!-- Tab Selector Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Terminal Console Body -->
                <RowDefinition Height="*"/>
                <!-- Footer Status -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Title / Drag Header ────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,8" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon + Title + Live Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2000E676" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                        <TextBlock Text="&gt;_" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" FontSize="12" Foreground="#00E676"/>
                    </Border>
                    <TextBlock Text="Terminal Logs" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    <Border Background="#1800E676" CornerRadius="4" Padding="5,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="● " Foreground="#00E676" FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Text="LIVE" Foreground="#00E676" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Actions: AutoScroll, Copy, Clear, Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAutoScroll"
                              IsChecked="True"
                              Content="Auto-scroll"
                              Foreground="#88FFFFFF"
                              FontSize="10.5"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"/>

                    <Button x:Name="BtnCopy"
                            Style="{StaticResource MiniActionBtn}"
                            Content="📋 Copy"
                            Margin="0,0,5,0"
                            Click="BtnCopy_Click"/>

                    <Button x:Name="BtnClear"
                            Style="{StaticResource MiniActionBtn}"
                            Content="🗑 Clear"
                            Margin="0,0,8,0"
                            Click="BtnClear_Click"/>

                    <Button x:Name="BtnClose"
                            Width="22" Height="22"
                            Style="{StaticResource MiniActionBtn}"
                            Content="✕"
                            Foreground="#FF6B6B"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- ── Pipeline Tab Bar (6 Tabs + All) ───────────── -->
            <Border Grid.Row="1" Background="#10FFFFFF" CornerRadius="8" Padding="4,4" Margin="0,0,0,8">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="BtnTabAll" Style="{StaticResource TabBtn}" Content="All" Click="BtnTab_Click" Tag="0"/>
                        <Button x:Name="BtnTabR1" Style="{StaticResource TabBtn}" Content="Health" Click="BtnTab_Click" Tag="1"/>
                        <Button x:Name="BtnTabR2" Style="{StaticResource TabBtn}" Content="Map" Click="BtnTab_Click" Tag="2"/>
                        <Button x:Name="BtnTabR3" Style="{StaticResource TabBtn}" Content="Inventory" Click="BtnTab_Click" Tag="3"/>
                        <Button x:Name="BtnTabR4" Style="{StaticResource TabBtn}" Content="Equipment" Click="BtnTab_Click" Tag="4"/>
                        <Button x:Name="BtnTabR5" Style="{StaticResource TabBtn}" Content="Enemy" Click="BtnTab_Click" Tag="5"/>
                        <Button x:Name="BtnTabR6" Style="{StaticResource TabBtn}" Content="Chest" Click="BtnTab_Click" Tag="6"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Terminal Console Output Viewers ───────────── -->
            <Border Grid.Row="2"
                    CornerRadius="8"
                    Background="#080D18"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid>
                    <TextBox x:Name="TxtLogAll" Style="{StaticResource TerminalBox}" Visibility="Visible"/>
                    <TextBox x:Name="TxtLogR1" Style="{StaticResource TerminalBox}" Visibility="Collapsed"/>
                    <TextBox x:Name="TxtLogR2" Style="{StaticResource TerminalBox}" Visibility="Collapsed"/>
                    <TextBox x:Name="TxtLogR3" Style="{StaticResource TerminalBox}" Visibility="Collapsed"/>
                    <TextBox x:Name="TxtLogR4" Style="{StaticResource TerminalBox}" Visibility="Collapsed"/>
                    <TextBox x:Name="TxtLogR5" Style="{StaticResource TerminalBox}" Visibility="Collapsed"/>
                    <TextBox x:Name="TxtLogR6" Style="{StaticResource TerminalBox}" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- ── Footer Status ──────────────────────────────── -->
            <Grid Grid.Row="3" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus"
                           Grid.Column="0"
                           Text="Listening to pipelines..."
                           FontSize="10"
                           Foreground="#66FFFFFF"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtLogCount"
                           Grid.Column="1"
                           Text="0 entries"
                           FontSize="10"
                           Foreground="#55FFFFFF"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
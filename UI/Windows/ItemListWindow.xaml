<Window x:Class="UI.Windows.ItemListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:UI.Models"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Width="315"
        SizeToContent="Height"
        Title="Item Whitelist">

    <Window.Background>
        <SolidColorBrush Color="#F0080E1A"/>
    </Window.Background>

    <Window.Resources>

        <!-- Filter pill button style -->
        <Style x:Key="FilterBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#B0FFFFFF"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#50FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox style â€” accent green -->
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd"
                                Width="18" Height="18"
                                CornerRadius="4"
                                BorderThickness="1.5"
                                BorderBrush="#50FFFFFF"
                                Background="#18FFFFFF">
                            <TextBlock x:Name="Check"
                                       Text="&#x2713;" FontSize="11" FontWeight="Bold"
                                       Foreground="#00E676"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check"   Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bd"      Property="BorderBrush" Value="#AA00E676"/>
                                <Setter TargetName="Bd"      Property="Background"  Value="#2200E676"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8800E676"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item row DataTemplate -->
        <DataTemplate x:Key="ItemRowTemplate" DataType="{x:Type models:ItemRow}">
            <Border x:Name="RowBd"
                    CornerRadius="8"
                    Background="#14FFFFFF"
                    BorderBrush="#10FFFFFF" BorderThickness="1"
                    Margin="0,0,0,5"
                    Padding="6,5"
                    Cursor="Hand"
                    MouseLeftButtonUp="Row_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon image or placeholder -->
                    <Border Grid.Column="0"
                            Width="28" Height="28"
                            CornerRadius="6"
                            Background="#1800E676"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="&#x1F4E6;" FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0.7"/>
                            <Image Source="{Binding ImageSource}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- Item Name -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Description}"
                               Foreground="#CCFFFFFF"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Enabled checkbox -->
                    <CheckBox Grid.Column="2"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                </Grid>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <!-- Glass panel -->
    <Border CornerRadius="16"
            BorderBrush="#28FFFFFF" BorderThickness="1"
            Padding="12,12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E8101828" Offset="0"/>
                <GradientStop Color="#E8080F1C" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24"
                               ShadowDepth="4" Opacity="0.6" Direction="315"/>
        </Border.Effect>

        <StackPanel>

            <!-- Header -->
            <DockPanel Margin="0,0,0,8" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Item Whitelist"
                           Foreground="#EEFFFFFF"
                           FontSize="13" FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <!-- Quick bulk toggle buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="BtnSelectAll" Content="All" Click="BtnSelectAll_Click"
                            ToolTip="Select all visible items"
                            Background="#18FFFFFF" Foreground="#00E676" BorderBrush="#3500E676"
                            BorderThickness="1" Padding="7,2" FontSize="10" FontWeight="SemiBold"
                            Cursor="Hand" Margin="0,0,4,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnDeselectAll" Content="None" Click="BtnDeselectAll_Click"
                            ToolTip="Deselect all visible items"
                            Background="#18FFFFFF" Foreground="#FF5252" BorderBrush="#35FF5252"
                            BorderThickness="1" Padding="7,2" FontSize="10" FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Type Category Filter Pills -->
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="BtnFilterAll" Content="All" Click="BtnFilter_Click" Tag="All"
                        Style="{StaticResource FilterBtnStyle}" Margin="0,0,5,3"/>
                <Button x:Name="BtnFilterResource" Content="Resource" Click="BtnFilter_Click" Tag="Resource"
                        Style="{StaticResource FilterBtnStyle}" Margin="0,0,5,3"/>
                <Button x:Name="BtnFilterConsumable" Content="Consumable" Click="BtnFilter_Click" Tag="Consumable"
                        Style="{StaticResource FilterBtnStyle}" Margin="0,0,5,3"/>
                <Button x:Name="BtnFilterSpecial" Content="Special" Click="BtnFilter_Click" Tag="Special"
                        Style="{StaticResource FilterBtnStyle}" Margin="0,0,5,3"/>
            </WrapPanel>

            <!-- Column labels -->
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Icon"
                           Foreground="#55FFFFFF" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Item Name"
                           Foreground="#55FFFFFF" FontSize="10" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="2" Text="Loot"
                           Foreground="#55FFFFFF" FontSize="10" HorizontalAlignment="Center"/>
            </Grid>

            <Rectangle Height="1" Fill="#18FFFFFF" Margin="0,0,0,6"/>

            <!-- Scrollable item list with Grouping -->
            <ScrollViewer MaxHeight="320"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <!-- Slim, styled scrollbar -->
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="6"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ScrollViewer.Resources>

                <ItemsControl x:Name="ItemsCtrl"
                              ItemTemplate="{StaticResource ItemRowTemplate}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="#1C00E676"
                                            BorderBrush="#3500E676"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,4"
                                            Margin="0,6,0,4">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       Foreground="#00E676"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                       FontSize="10"
                                                       Foreground="#75FFFFFF"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
            </ScrollViewer>

        </StackPanel>
    </Border>
</Window>
<Window x:Class="UI.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Width="960" Height="540"
        MinWidth="160" MinHeight="120"
        Title="GrimSoul Overlay">

    <Grid x:Name="RootGrid" Background="#01000000">
        <!-- Animated dashed selection border for MR -->
        <Rectangle x:Name="BorderRect"
                   Stroke="#00E676"
                   StrokeThickness="2"
                   StrokeDashArray="8,4"
                   StrokeDashCap="Round"
                   Fill="Transparent"
                   IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect Color="#00E676" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- Corner accent markers (TL, TR, BL, BR) -->
        <Canvas IsHitTestVisible="False">
            <!-- TL horizontal & vertical -->
            <Rectangle Canvas.Left="0" Canvas.Top="0" Width="20" Height="3" Fill="#00E676"/>
            <Rectangle Canvas.Left="0" Canvas.Top="0" Width="3" Height="20" Fill="#00E676"/>
            <!-- TR horizontal & vertical -->
            <Rectangle Canvas.Right="0" Canvas.Top="0" Width="20" Height="3" Fill="#00E676"
                       HorizontalAlignment="Right"/>
            <Rectangle Canvas.Right="0" Canvas.Top="0" Width="3" Height="20" Fill="#00E676"
                       HorizontalAlignment="Right"/>
        </Canvas>

        <Grid IsHitTestVisible="False">
            <!-- BL horizontal & vertical -->
            <Rectangle Width="20" Height="3" Fill="#00E676"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
            <Rectangle Width="3" Height="20" Fill="#00E676"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
            <!-- BR horizontal & vertical -->
            <Rectangle Width="20" Height="3" Fill="#00E676"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            <Rectangle Width="3" Height="20" Fill="#00E676"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- MR Grid canvas — drawn programmatically; hidden by default -->
        <Canvas x:Name="GridCanvas"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>

        <!-- Sub-Regions canvas for the 3 movable & lockable scan zones -->
        <Canvas x:Name="SubRegionsCanvas" ClipToBounds="True"/>

        <!-- MR Move Handle (Bottom-Right corner) -->
        <Border x:Name="MrMoveHandle"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,8,8"
                Width="38" Height="38"
                CornerRadius="10"
                Background="#EE0A1424"
                BorderBrush="#00E676"
                BorderThickness="2"
                Cursor="SizeAll"
                ToolTip="Click &amp; hold to move Main Rectangle (MR)"
                MouseLeftButtonDown="MrMoveHandle_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#00E676" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="✥"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#00E676"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="MR"
                           FontSize="8.5"
                           FontWeight="Bold"
                           Foreground="#00E676"
                           HorizontalAlignment="Center"
                           Margin="0,-2,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
